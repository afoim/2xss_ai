{
  "name": "2xss_ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "二叉树树 AI 生图（纯 CSR，登录态由论坛授权交接）",
  "scripts": {
    "dev": "node scripts/build-icon-subset.mjs && vite",
    "build": "node scripts/build-icon-subset.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/build-icon-subset.mjs && tsc --noEmit"
  },
  "//": "pnpm 10 默认不执行依赖的 install/build 脚本，未批准的构建会让 pnpm install 以 ERR_PNPM_IGNORED_BUILDS 退出 1（CI 直接失败）。",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.1.1",
    "@fontsource-variable/geist-mono": "^5.1.1",
    "@iconify/react": "^6.0.2",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "recharts": "^3.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.91",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
