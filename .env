# 部署基路径。空 = 站点根（独立子域名，/img2img）；设成 /draw 则沿用主站老 URL。
# 改这里等于同时改了 vite 的 base 与 React Router 的 basename。
VITE_BASE_PATH=

# 本站对外地址（目前只用于文档与 wrangler 部署，不进 canonical —— 生图页全是 noindex）
VITE_SITE_URL=https://ai.acofork.com

# 论坛站点。**登录靠它**：未登录时跳到 <这个地址>/auth/authorize 做一次显式授权，
# 拿回论坛的 token 存进本站 localStorage（见 src/lib/auth-bridge.ts）。
# 换域名时论坛那边的 VITE_AUTH_ALLOWED_ORIGINS 也要同步放行本站，否则授权页会拒绝。
VITE_FORUM_SITE_URL=https://bbs.acofork.com

# 论坛后端（查"我是谁"、退出登录）
VITE_FORUM_API_BASE=https://i.2x.nz

# 生图后端。它认的就是论坛的 JWT，所以没有第二套账号
VITE_DRAW_API_BASE=https://api-ai.acofork.com
